{
	"name": "webentwicklerin/we-formkit",
	"description": "Modular WordPress form builder with typed fields, entries, and a developer module API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "webentwicklerin, Gabriele Laesser",
			"homepage": "https://webentwicklerin.at"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"squizlabs/php_codesniffer": "^3.13.5",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"files": [
			"includes/autoload.php"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"preflight": "node scripts/preflight-deploy.js",
		"preflight:warn": "node scripts/preflight-deploy.js --warn-only"
	}
}
